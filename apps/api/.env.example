NODE_ENV=development
# Fastify server port — apps/index.ts reads this directly, already effective via `tsx watch
# --env-file=.env` (package.json's `dev` script) loading this file before any app code runs. If you
# change this, also update apps/web/.env's API_ORIGIN to match.
PORT=3001
# Port 5433, not 5432: avoids colliding with a locally-installed Postgres (e.g. Postgres.app)
# that may already be listening on the default port.
# DATABASE_URL: used ONLY by drizzle-kit (migrations) — connects as the superuser/owner role
# ("tm" locally). Never used by the running Fastify server.
# Local dev: the docker-compose.yml Postgres container (direct connection is fine at this scale).
# Staging/production (Neon): use the pooled connection string (the "-pooler" hostname variant,
# PgBouncer transaction-pooling mode), NOT the direct string — required so the app's pg.Pool
# doesn't compete for Neon's per-tier direct-connection ceiling. See research.md §5.
DATABASE_URL=postgresql://tm:tm_password@localhost:5433/tm_dev
# APP_DATABASE_URL: used by the running Fastify server's connection pool. Connects as the
# restricted "tm_app" role (created by drizzle/init/01-app-role.sql locally; an operator must
# create the equivalent role by hand against Neon in staging/production, since Neon has no
# docker-entrypoint-initdb.d equivalent — see drizzle/README.md). This role has SELECT-only on the
# permissions/role_templates/role_template_permissions catalog (FR-002) and full CRUD on the
# tenant-scoped roles/role_permissions/user_roles tables, enforced by 0001_lock_catalog_grants.sql.
APP_DATABASE_URL=postgresql://tm_app:tm_app_password@localhost:5433/tm_dev
# Must match apps/web's actual dev PORT (apps/web/.env) — the browser's Origin header on every
# request apps/web proxies through will be this, and Fastify's CORS plugin rejects anything else.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Tenant Authentication Configuration spec — used only to build the {tenant}.{ROOT_DOMAIN} link
# inside password-reset emails (apps/api never routes requests itself; this is link text only), so
# it embeds apps/web's actual dev port. Update the port here (and CORS_ORIGIN above) together
# whenever you change apps/web's PORT. Domain-only part must still match apps/web/.env's own
# ROOT_DOMAIN (Spec 4) — that one is never port-suffixed, since middleware.ts strips the port off an
# incoming Host header before comparing.
ROOT_DOMAIN=lvh.me:3000
# MAIL_*: real credentials required to actually send one-time-password/reset emails via ZeptoMail's
# API (tenant-auth/mailer.ts, mail/zeptomail-sender.ts). An empty/unset MAIL_API_TOKEN or
# MAIL_FROM_EMAIL is treated as "not configured" and skipped (logged instead) rather than attempted —
# safe to leave unset in environments that don't need real email delivery (e.g. most of the automated
# test suite). Provider-agnostic names, not ZeptoMail-specific — see Email API Mailer spec.
MAIL_API_TOKEN=
# Must already be a verified sender identity in the ZeptoMail account.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TM
# Optional — override for a region-specific ZeptoMail account (e.g. the EU endpoint). Defaults to
# https://api.zeptomail.com/v1.1/email if unset.
MAIL_API_URL=
# R2_*: Cloudflare R2 (S3-compatible) credentials for the File Upload & Storage spec
# (storage/r2-client.ts). Unlike MAIL_*, an unconfigured storage client causes upload requests to fail
# loudly (503) rather than being silently skipped — there is no fallback path that still delivers this
# feature's value without storage (research.md §8). The R2 endpoint is derived at runtime as
# https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com, not its own separate env var.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# AI_PROVIDER_*: AI Foundation (ai/provider/invoke-ai.ts). An unset AI_PROVIDER_API_KEY means
# `isConfigured()` returns false and every AI request fails loudly with a 503 — like R2, not like
# MAIL_*, since there's no meaningful fallback for a chat request the user is waiting on.
# Never stored in the database, never tenant-configurable — platform-operator-only for now (AI
# Foundation Phase 5; a per-tenant AI settings UI is a later, explicitly out-of-scope phase).
#
# AI_PROVIDER: which AiProvider implementation invoke-ai.ts wires in — "anthropic" (default, used
# for unset/unrecognized values) or "openai".
AI_PROVIDER=
# API key for whichever provider AI_PROVIDER selects — an Anthropic key for "anthropic", an OpenAI
# key for "openai". Only one provider is ever active, so there's just the one var.
AI_PROVIDER_API_KEY=
# Model id for whichever provider AI_PROVIDER selects. Optional — defaults to a current Claude
# model for "anthropic" (anthropic-provider.ts) or a current GPT model for "openai"
# (openai-provider.ts) if unset.
AI_PROVIDER_MODEL=

# IMAGE_PROVIDER_*: AI Image Discovery & Course Asset Management Phase 1 (images/image-search-service.ts).
# Same "no meaningful fallback, fail loudly with a 503" pattern as AI_PROVIDER_* above — an
# unconfigured key means search_course_images/set_course_image/set_lesson_image are unavailable, not
# silently degraded.
#
# IMAGE_PROVIDER: which ImageProvider implementation is active — "unsplash" (default, and the only
# implementation this phase). Kept as its own var (rather than hardcoding "unsplash" everywhere) so
# a future provider can be added without changing every call site, mirroring AI_PROVIDER's own
# swappable-implementation shape.
IMAGE_PROVIDER=
# Unsplash Access Key (a demo/production API application's Client ID) for IMAGE_PROVIDER=unsplash.
# Demo mode is capped at 50 requests/hour; production approval (via Unsplash's own application
# process) raises this — see UnsplashProvider's own doc comment.
IMAGE_PROVIDER_API_KEY=

# DEFAULT_THEME: UI Theme Switching — which design (apps/web/app/globals.css) the app renders with
# the very first time this deploys, before any Super Admin has ever set one from /platform/settings.
# Once a Super Admin sets one, their choice (stored in the `platform_settings` DB row) always wins
# over this — this var only matters pre-first-write. "navy" (default, unset/unrecognized value) or
# "violet". Global for the whole app, not per-tenant.
DEFAULT_THEME=
