NODE_ENV=development
# Fastify server port — apps/index.ts reads this directly, already effective via `tsx watch
# --env-file=.env` (package.json's `dev` script) loading this file before any app code runs. If you
# change this, also update apps/web/.env's API_ORIGIN to match.
PORT=3001
# Port 5433, not 5432: avoids colliding with a locally-installed Postgres (e.g. Postgres.app)
# that may already be listening on the default port.
# DATABASE_URL: used ONLY by drizzle-kit (migrations) — connects as the superuser/owner role
# ("tm" locally). Never used by the running Fastify server.
# Local dev: the docker-compose.yml Postgres container (direct connection is fine at this scale).
# Staging/production (Neon): use the pooled connection string (the "-pooler" hostname variant,
# PgBouncer transaction-pooling mode), NOT the direct string — required so the app's pg.Pool
# doesn't compete for Neon's per-tier direct-connection ceiling. See research.md §5.
DATABASE_URL=postgresql://tm:tm_password@localhost:5433/tm_dev
# APP_DATABASE_URL: used by the running Fastify server's connection pool. Connects as the
# restricted "tm_app" role (created by drizzle/init/01-app-role.sql locally; an operator must
# create the equivalent role by hand against Neon in staging/production, since Neon has no
# docker-entrypoint-initdb.d equivalent — see drizzle/README.md). This role has SELECT-only on the
# permissions/role_templates/role_template_permissions catalog (FR-002) and full CRUD on the
# tenant-scoped roles/role_permissions/user_roles tables, enforced by 0001_lock_catalog_grants.sql.
APP_DATABASE_URL=postgresql://tm_app:tm_app_password@localhost:5433/tm_dev
# Must match apps/web's actual dev PORT (apps/web/.env) — the browser's Origin header on every
# request apps/web proxies through will be this, and Fastify's CORS plugin rejects anything else.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Tenant Authentication Configuration spec — used only to build the {tenant}.{ROOT_DOMAIN} link
# inside password-reset emails (apps/api never routes requests itself; this is link text only), so
# it embeds apps/web's actual dev port. Update the port here (and CORS_ORIGIN above) together
# whenever you change apps/web's PORT. Domain-only part must still match apps/web/.env's own
# ROOT_DOMAIN (Spec 4) — that one is never port-suffixed, since middleware.ts strips the port off an
# incoming Host header before comparing.
ROOT_DOMAIN=lvh.me:3000
# MAIL_*: real credentials required to actually send one-time-password/reset emails via ZeptoMail's
# API (tenant-auth/mailer.ts, mail/zeptomail-sender.ts). An empty/unset MAIL_API_TOKEN or
# MAIL_FROM_EMAIL is treated as "not configured" and skipped (logged instead) rather than attempted —
# safe to leave unset in environments that don't need real email delivery (e.g. most of the automated
# test suite). Provider-agnostic names, not ZeptoMail-specific — see Email API Mailer spec.
MAIL_API_TOKEN=
# Must already be a verified sender identity in the ZeptoMail account.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TM
# Optional — override for a region-specific ZeptoMail account (e.g. the EU endpoint). Defaults to
# https://api.zeptomail.com/v1.1/email if unset.
MAIL_API_URL=
