{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DEBUG=* drizzle-kit migrate",
    "seed:super-admin": "tsx --env-file=.env scripts/seed-super-admin.ts",
    "purge:deleted-tenants": "tsx --env-file=.env scripts/purge-deleted-tenants.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/postgres": "^6.0.0",
    "adm-zip": "^0.6.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.0.0",
    "fastify-plugin": "5.1.0",
    "mammoth": "^1.12.1",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tm/eslint-config": "workspace:*",
    "@tm/tsconfig": "workspace:*",
    "@tm/types": "workspace:*",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
