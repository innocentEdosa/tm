{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DEBUG=* drizzle-kit migrate",
    "seed:super-admin": "tsx --env-file=.env scripts/seed-super-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/postgres": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "5.1.0",
    "nodemailer": "^9.0.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@tm/eslint-config": "workspace:*",
    "@tm/tsconfig": "workspace:*",
    "@tm/types": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
