# Server-only (no NEXT_PUBLIC_ prefix) — read by next.config.ts's rewrite proxy, not by client
# code. The browser never talks to apps/api directly; it fetches relative /platform-api/* paths,
# which this app's own server proxies to API_ORIGIN. Keeps the Super Admin session cookie
# same-origin from the browser's point of view (avoids third-party-cookie blocking).
API_ORIGIN=http://localhost:3001

# Read by middleware.ts to classify Host headers as root domain vs. a candidate tenant subdomain
# (spec 004 FR-002). lvh.me always resolves to 127.0.0.1 — no local DNS/hosts-file edit needed for
# subdomain testing (e.g. acmecorp.lvh.me:3000). Production sets this to the real root domain
# (tm.com) via the hosting provider's environment configuration.
ROOT_DOMAIN=lvh.me

# HMAC key for middleware.ts's short-lived (60s) signed tenant-resolve cache cookie — avoids
# re-fetching /tenant-routing/resolve from apps/api on every single request to the same tenant
# subdomain. Signed so a tampered cookie is rejected and treated as a cache miss (never trusted
# as-is) rather than silently accepted. Must be set to a real random value in staging/production;
# rotate it to invalidate all outstanding cache cookies at once.
TENANT_RESOLVE_CACHE_SECRET=
